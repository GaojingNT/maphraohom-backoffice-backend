# App config
ENV="local"
HTTP_PORT=8000
GRPC_PORT=8001
APP_NAME="Maphraohom - Backoffice Service"
SERVICE_NAME="maphraohom-backoffice-service"
APP_FRONTEND_URL="http://localhost:3000"

# Fiber config
FIBER_PREFORK=false
CORS_ALLOW_ORIGINS="*"
RATE_LIMIT=60

# Database config (matches docker-compose.yml postgres_db service)
DATABASE_DRIVER="postgresql"
DATABASE_HOST="localhost"
DATABASE_PORT=5432
DATABASE_NAME="postgres"
DATABASE_USER="postgres"
DATABASE_PASSWORD="mysecretpassword"
DATABASE_TIMEZONE="Asia/Bangkok"
DATABASE_MAX_IDLE_CONNS=2
DATABASE_MAX_OPEN_CONNS=3
DATABASE_SSL_MODE="disable"

# Redis config (matches docker-compose.yml redis service)
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_USERNAME=""
REDIS_PASSWORD=""
REDIS_CACHE_PREFIX="maphraohom-backoffice"
REDIS_CACHE_DURATION=5

# Sentry config (disabled locally)
SENTRY_DSN=""
SENTRY_ERROR_TRACING=false
SENTRY_TRACES_SAMPLE_RATE=0.2

# OpenTelemetry config (disabled locally)
OTEL_EXPORTER_OTLP_ENDPOINT=""
OTEL_INSECURE_MODE=true

# Auth config
AUTH_KEYCLOAK_ENDPOINT="http://localhost:8080"
AUTH_KEYCLOAK_REALM="master"
AUTH_SECRET_KEY="local-dev-secret-change-me"

# Logger
LOGGER_MODE="none"
LOGGER_PATH="./logs"
LOGGER_GRAYLOG_ENDPOINT="localhost"
LOGGER_GRAYLOG_PORT=12201
LOGGER_GRAYLOG_TLS_ENABLED=false
LOGGER_GRAYLOG_TLS_SKIP_VERIFY=true
LOGGER_S3_PATH="logs"
LOGGER_S3_ENDPOINT="localhost:9000"
LOGGER_S3_ACCESS_KEY_ID=""
LOGGER_S3_SECRET_KEY=""
LOGGER_S3_BUCKET_NAME="my-bucket"
LOGGER_S3_REGION="us-east-1"
LOGGER_S3_PREFIX=""
LOGGER_S3_USE_SSL=false
LOGGER_S3_MAX_FILE_KB_SIZE=10240
LOGGER_GCP_PARENT_ID="my-project"
LOGGER_GCP_LOG_ID="my-log"

# FileSystem (local disk, no MinIO required to boot)
FILE_SYSTEM_DISK="local"
FILE_SYSTEM_LOCAL_PATH="./storage"
FILE_SYSTEM_S3_ENDPOINT="localhost:8900"
FILE_SYSTEM_S3_ACCESS_KEY_ID="admin-access-key"
FILE_SYSTEM_S3_SECRET_KEY="admin-secret-key"
FILE_SYSTEM_S3_BUCKET_NAME="maphraohom-backoffice"
FILE_SYSTEM_S3_REGION="us-east-1"
FILE_SYSTEM_S3_PREFIX=""
FILE_SYSTEM_S3_USE_SSL=false
